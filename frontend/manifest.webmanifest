{
  "name": "Pendataan Santri",
  "short_name": "SantriApp",
  "description": "Sistem pendataan santri pesantren berbasis web.",
  "start_url": "/pages/login/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f7e7c2",
  "theme_color": "#9e2f22",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "icons/icon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
